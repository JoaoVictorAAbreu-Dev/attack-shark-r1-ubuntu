#!/bin/sh
set -e
if command -v udevadm >/dev/null 2>&1; then
    udevadm control --reload-rules || true
    udevadm trigger --subsystem-match=usb --attr-match=idVendor=1d57 --attr-match=idProduct=fa60 || true
    udevadm trigger --subsystem-match=usb --attr-match=idVendor=1d57 --attr-match=idProduct=fa61 || true
fi
exit 0
